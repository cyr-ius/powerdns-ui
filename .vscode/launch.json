{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["FastAPI", "Angular"]
    }
  ],
  "configurations": [
    {
      "name": "FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--log-level", "debug"],
      "jinja": true,
      "preLaunchTask": "docker: start pdns",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal"
    },
    {
      "name": "Angular",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start - frontend",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "Docs: MkDocs (port 8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "mkdocs",
      "args": ["serve", "-a", "127.0.0.1:8001"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Serving on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
